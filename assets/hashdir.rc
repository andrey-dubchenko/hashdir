// Windows resources linked into hashdir.exe: the icon and the version information.
// Regenerate the object file (from this directory):
//   windres --use-temp-file -O coff -i hashdir.rc -o ../hashdir_windows_amd64.syso

1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION 1,2,0,0
PRODUCTVERSION 1,2,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Directory hash calculator (sha256, md5)"
      VALUE "FileVersion", "1.2.0.0"
      VALUE "InternalName", "hashdir"
      VALUE "OriginalFilename", "hashdir.exe"
      VALUE "ProductName", "hashdir"
      VALUE "ProductVersion", "1.2.0.0"
      VALUE "CompanyName", "Andrey Dubchenko"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
